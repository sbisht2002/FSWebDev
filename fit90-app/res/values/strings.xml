    <string name="body_body">Add your height, weight, target weight and goal (muscular, lean or maintain) to personalise the Fitness program: calories, protein, water, meal portions and training volume. You can do this later in Settings.</string>
    <string name="body_set_up">Set up fitness profile</string>
