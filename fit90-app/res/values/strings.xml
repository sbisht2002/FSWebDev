    <!-- Onboarding -->
    <string name="age_title">This app is for adults</string>
    <string name="age_body">It covers men\'s sexual health in a clinical, non-explicit way. Please confirm you are 18 or older.</string>
    <string name="age_yes">I\'m 18 or older</string>
    <string name="age_no">I\'m under 18</string>
    <string name="blocked_title">Sorry, this app is for adults only</string>
    <string name="blocked_body">If you have questions about your body or health, a parent, school nurse or doctor is a great place to start. In India you can call Tele-MANAS on 14416 for free mental-health support, any time.</string>
    <string name="welcome_title">Welcome</string>
    <string name="welcome_body">Short daily sessions to help with lasting longer, firmer erections, less anxiety and better intimacy, built on evidence and written in plain, respectful language.</string>
    <string-array name="welcome_points">
        <item>A 10-level pelvic-floor trainer with voice, sound and vibration cues</item>
        <item>Breathing, body-scan and confidence sessions you can do anywhere</item>
        <item>Clear lessons on technique, diet, exercise, sleep and intimacy, with sources</item>
        <item>A personal 8-week plan, streaks and progress, all private</item>
    </string-array>
    <string name="privacy_promise_title">Our privacy promise</string>
    <string name="privacy_promise_body">- **No account.** You never sign up or give your name, email or number.\n- **Everything stays on this phone,** encrypted. We have no servers holding your data.\n- **No ads, no trackers, no analytics.**\n- **You\'re in control:** export your data or delete everything in one tap from Settings.\n- Notifications use neutral wording, and you can add a PIN lock and a discreet app icon.</string>
    <string name="privacy_agree">Sounds good</string>
